@page "/counter"
@rendermode InteractiveServer

<PageTitle>Counter</PageTitle>

<h1>Counter</h1>

<div class="counter-container">
    <p role="status" class="count-display">Current count: <strong>@currentCount</strong></p>
    
    @if (currentCount == 0)
    {
        <p class="text-muted">Start clicking to begin counting!</p>
    }
    else if (currentCount < 5)
    {
        <p class="text-info">Getting warmed up! You've clicked @currentCount time@(currentCount == 1 ? "" : "s").</p>
    }
    else if (currentCount < 10)
    {
        <p class="text-primary">Keep going! You're at @currentCount clicks.</p>
    }
    else
    {
        <p class="text-success">Amazing! You've reached @currentCount clicks!</p>
    }
    
    <div class="button-group mt-3">
        <button class="btn btn-primary" @onclick="IncrementCount">
            Click me (+1)
        </button>
        
        @if (currentCount > 0)
        {
            <button class="btn btn-outline-secondary ms-2" @onclick="ResetCount">
                Reset (↻)
            </button>
        }
    </div>
</div>

<style>
    .counter-container {
        max-width: 500px;
        margin: 0 auto;
        padding: 20px;
        border-radius: 10px;
        background-color: #f8f9fa;
        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    }
    
    .count-display {
        font-size: 1.5rem;
        margin-bottom: 20px;
    }
    
    .button-group {
        display: flex;
        gap: 10px;
    }
</style>

@code {
    private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
    }
    
    private void ResetCount()
    {
        currentCount = 0;
    }
}
